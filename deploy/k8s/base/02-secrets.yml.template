apiVersion: v1
kind: Secret
metadata:
  name: aircargo-secrets
  namespace: aircargo
  labels:
    app: aircargo
type: Opaque
stringData:
  # REQUIRED: Generate with: openssl rand -base64 64
  JWT_SECRET: "REPLACE_WITH_GENERATED_SECRET_MIN_32_CHARS"
  
  # REQUIRED: Database password
  POSTGRES_USER: "aircargo_user"
  POSTGRES_PASSWORD: "REPLACE_WITH_STRONG_PASSWORD"
  
  # REQUIRED: RabbitMQ password
  RABBITMQ_USER: "aircargo"
  RABBITMQ_PASSWORD: "REPLACE_WITH_STRONG_PASSWORD"
  
  # REQUIRED: Encryption key for AES-256-GCM (generate with: openssl rand -base64 32)
  APP_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY"
  
  # SMTP Configuration
  SMTP_HOST: "smtp.example.com"
  SMTP_PORT: "587"
  SMTP_USERNAME: "noreply@example.com"
  SMTP_PASSWORD: "REPLACE_WITH_SMTP_PASSWORD"
  SMTP_FROM: "noreply@example.com"
  
  # Optional: S3 for backups
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
  AWS_S3_BUCKET: ""
  AWS_REGION: "us-east-1"
   
  # MFA Policy - disable reset on startup for production
  MFA_RESET_ON_STARTUP: "false"